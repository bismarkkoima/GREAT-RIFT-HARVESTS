# Database (SQLite for local dev; use a postgresql:// URL in production after switching the provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (used for SEO, sitemap and the M-Pesa callback)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number for the chat button, international format without "+" (e.g. 254712345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@greatriftharvests.co.ke"
ADMIN_PASSWORD="ChangeMe123!"

# M-Pesa Daraja (STK Push). Leave blank to run checkout in simulation mode.
MPESA_ENV="sandbox"            # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""

# Email (any SMTP provider: Gmail app password, Zoho, Brevo, Resend SMTP…). Leave SMTP_HOST blank to print emails to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Great Rift Harvests <orders@greatriftharvests.co.ke>"
# Where new-order and contact-form alerts go, comma separated (defaults to every admin account)
ADMIN_NOTIFY_EMAIL=""

# SMS via Africa's Talking. Use AT_USERNAME="sandbox" for testing. Leave blank to print SMS to the server log.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# Secret for the daily subscription job (GET /api/cron/subscriptions with "Authorization: Bearer <CRON_SECRET>").
# Vercel Cron sends it automatically when this variable is set. Generate one with: openssl rand -base64 32
CRON_SECRET=""
